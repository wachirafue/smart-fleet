{
    "name":  "smart-fleet-backend",
    "version":  "1.0.0",
    "description":  "Smart Fleet Management Backend - Node.js/Express/MQTT/Prisma",
    "main":  "src/server.js",
    "scripts":  {
                    "dev":  "nodemon src/server.js",
                    "start":  "node src/server.js",
                    "db:migrate":  "prisma migrate dev",
