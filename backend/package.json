                    "db:studio":  "prisma studio",
                    "generate:vapid":  "node scripts/generateVapid.js"
                },
    "dependencies":  {
                         "@prisma/client":  "^5.14.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.19.2",
                         "mqtt":  "^5.7.0",
                         "web-push":  "^3.6.7"
                     },
    "devDependencies":  {
                            "nodemon":  "^3.1.4",
                            "prisma":  "^5.14.0"
                        },
    "prisma":  {
                   "seed":  "node prisma/seed.js"
               }
}
